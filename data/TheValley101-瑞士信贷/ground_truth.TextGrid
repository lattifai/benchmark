        intervals [2]:
            xmin = 1597.9565123647897
            xmax = 1603.779585113326
            text = "Goldman Sachs and Morgan Stanley confirmed The Walls they have large exposure, 10 to 15 billion dollars respectively. Their management..."
        intervals [3]:
