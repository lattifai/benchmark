        intervals [2]:
            xmin = 202.29576444773085
            xmax = 214.5322596161743
            text = "SoftBank's mission is to, to invest in the No. 1 player in each sector. Greensill in the last 8 years has significantly disrupted the way working capitals delivered the world over. And SoftBank..."
        intervals [3]:
            xmin = 214.5322596161743
            xmax = 2243.022
            text = ""
    item [5]:
        class = "IntervalTier"
